<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <SpaRoot>..\Koppel.UI\</SpaRoot>
    <SpaProxyLaunchCommand>pnpm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>https://localhost:61040</SpaProxyServerUrl>
  </PropertyGroup>

  <!-- The Windows icon for Koppel.exe. The Docker build only sees src/, and Linux has no use for it. -->
  <PropertyGroup Condition="Exists('$(MSBuildThisFileDirectory)..\..\..\..\resources\design-system\assets\Logos\koppel-app-icon.ico')">
    <ApplicationIcon>$(MSBuildThisFileDirectory)..\..\..\..\resources\design-system\assets\Logos\koppel-app-icon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Generated by installer/new-notices.ps1 and shipped in the MSI and the image. -->
  <ItemGroup>
    <None Include="THIRD-PARTY-NOTICES.txt" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Development settings point at a repo folder; an installed or published Koppel must not carry them. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SpaRoot)Koppel.UI.esproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Koppel.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Koppel.Core\src\Koppel.Core.Auth\Koppel.Core.Auth.csproj" />
    <ProjectReference Include="..\..\..\Koppel.Core\src\Koppel.Core.Usb\Koppel.Core.Usb.csproj" />
    <ProjectReference Include="..\..\..\Koppel.Core\src\Koppel.Core.Activity\Koppel.Core.Activity.csproj" />
    <ProjectReference Include="..\..\..\Koppel.Core\src\Koppel.Core.Discovery\Koppel.Core.Discovery.csproj" />
  </ItemGroup>

  <!-- Builds the SPA and stages dist/ into wwwroot/ on publish. -->
  <Target Name="PublishRunWebpack" AfterTargets="ComputeFilesToPublish">
    <Exec WorkingDirectory="$(SpaRoot)" Command="pnpm install" Condition="'$(SkipSpaInstall)' != 'true'" />
    <Exec WorkingDirectory="$(SpaRoot)" Command="pnpm run build" />
    <ItemGroup>
      <DistFiles Include="$(SpaRoot)dist\**" />
      <ResolvedFileToPublish Include="@(DistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
        <RelativePath>wwwroot\%(RecursiveDir)%(FileName)%(Extension)</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
        <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>

</Project>
