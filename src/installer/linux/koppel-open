#!/bin/sh
# Opens Koppel's UI in the user's browser, from the applications menu entry (koppel.desktop). The port is
# KOPPEL_UI_PORT from /etc/default/koppel, where the service reads its settings, or Ports__Ui, its 0.1.x
# name, or 5240. The names are matched without regard to case.
port=5240
if [ -r /etc/default/koppel ]; then
  for name in koppel_ui_port ports__ui; do
    value=$(sed -n "s/^[[:space:]]*$name[[:space:]]*=[[:space:]]*//Ip" /etc/default/koppel | tail -n 1 | tr -d "\"' \r")
    [ -n "$value" ] && break
  done
  case "$value" in
    '' | *[!0-9]*) ;;
    *) port=$value ;;
  esac
fi
exec xdg-open "https://localhost:$port/"
