<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/1.0.4338480">
  <PropertyGroup>
    <StartupCommand>pnpm run dev</StartupCommand>
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <!-- pnpm workspace install runs at the repo root; npm cannot resolve workspace: deps. -->
    <ShouldRunNpmInstall>false</ShouldRunNpmInstall>
    <ShouldRunNpmAudit>false</ShouldRunNpmAudit>
    <BuildOutputFolder>$(MSBuildProjectDirectory)\dist</BuildOutputFolder>
  </PropertyGroup>
</Project>
