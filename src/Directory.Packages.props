<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Microsoft.AspNetCore.SpaProxy uses a floating 10.*-* version (host project), as in Matumi. -->
    <CentralPackageFloatingVersionsEnabled>true</CentralPackageFloatingVersionsEnabled>
    <!-- Lets the security pins below lift vulnerable transitive packages. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Host -->
    <PackageVersion Include="Microsoft.AspNetCore.SpaProxy" Version="10.*-*" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.14" />

    <!-- Auth: OAuth server and token validation -->
    <PackageVersion Include="OpenIddict.AspNetCore" Version="7.7.2" />

    <!-- Security pins: OpenIddict pulls 10.0.11 of these, which have published advisories. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.14" />

    <!-- Windows installer. WiX 5, not 6: 6's binaries come under the Open Source Maintenance Fee EULA. -->
    <PackageVersion Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageVersion Include="WixToolset.Bal.wixext" Version="5.0.2" />

    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="AwesomeAssertions" Version="9.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageVersion Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.14" />
  </ItemGroup>
</Project>
