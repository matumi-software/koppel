<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>0.1.2</Version>
    <!-- packages.lock.json beside every project, committed. The installer and Docker builds restore with
         -p:RestoreLockedMode=true, so a build fails instead of picking up a different package. Regenerate with
         `dotnet restore` after changing a package version. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <!-- The platforms Koppel is published for. Restoring for all of them puts every one in the lock files, so the
       builds restore in locked mode without -r and then publish with no-restore and -r (rid). `dotnet restore -r`
       would restore one only and fail against the lock file. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.csproj'">
    <RuntimeIdentifiers>win-x64;linux-x64;linux-arm64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
