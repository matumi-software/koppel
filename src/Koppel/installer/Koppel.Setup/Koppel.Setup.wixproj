<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- setup.exe: the VC++ runtime usbip-win2's tools need, then Koppel's MSI. An MSI cannot install
       the runtime itself, because the runtime's installer is an MSI too. build.ps1 passes the paths. -->
  <PropertyGroup>
    <OutputType>Bundle</OutputType>
    <OutputName>Koppel-Setup</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- The app icon and logo come from the design system (pnpm design:icons renders them). -->
    <Logos>$(MSBuildThisFileDirectory)..\..\..\..\resources\design-system\assets\Logos</Logos>
    <DefineConstants>Version=$(Version);Msi=$(Msi);VCRedist=$(VCRedist);VCRedistBuild=$(VCRedistBuild);Logos=$(Logos)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Bal.wixext" />
    <PackageReference Include="WixToolset.Util.wixext" />
  </ItemGroup>

</Project>
