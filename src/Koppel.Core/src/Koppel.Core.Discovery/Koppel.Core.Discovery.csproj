<Project Sdk="Microsoft.NET.Sdk">

  <!-- Finding Koppel servers on the local network with multicast DNS (DNS-SD).
       Announcing: Makaretu.Dns.Multicast.New, the maintained fork of the most used .NET mDNS library.
       Browsing: Tmds.MDns, the best maintained .NET mDNS browser. Neither alone does both well. -->
  <ItemGroup>
    <PackageReference Include="Makaretu.Dns.Multicast.New" />
    <PackageReference Include="Tmds.MDns" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koppel.Core.Configuration\Koppel.Core.Configuration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Koppel.Core.Discovery.Tests" />
  </ItemGroup>

</Project>
