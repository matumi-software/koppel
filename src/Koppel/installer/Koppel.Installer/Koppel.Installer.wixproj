<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- The MSI: Koppel as a Windows service, plus usbip-win2's driver. build.ps1 stages the files. -->
  <PropertyGroup>
    <OutputName>Koppel</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE61: MajorUpgrade AllowSameVersionUpgrades is deliberate, see Package.wxs. -->
    <SuppressIces>ICE61</SuppressIces>
    <Logos>$(MSBuildThisFileDirectory)..\..\..\..\resources\design-system\assets\Logos</Logos>
    <DefineConstants>StagingDir=$(StagingDir);Version=$(Version);Logos=$(Logos)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
    <PackageReference Include="WixToolset.Firewall.wixext" />
  </ItemGroup>

</Project>
