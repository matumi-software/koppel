[Unit]
Description=Koppel, USB over IP
Documentation=https://github.com/matumi-software/koppel
Wants=network-online.target
After=network-online.target

[Service]
# Koppel tells systemd when it is ready (UseSystemd in Program.cs).
Type=notify
ExecStart=/usr/lib/koppel/Koppel
WorkingDirectory=/usr/lib/koppel
# Root, as in the Docker image: binding devices to usbip-host and attaching through vhci-hcd writes to /sys.
User=root
# Config and keys go to /var/lib/koppel, Koppel's default on Linux. Koppel locks both folders to root itself.
StateDirectory=koppel
StateDirectoryMode=0700
# Settings as environment variables, e.g. Ports__Ui=5250 or Ui__AllowFrom=lan. Optional file.
EnvironmentFile=-/etc/default/koppel
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
