<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <!-- The bundle is what the Apps list shows, so its icon is the one people see there. -->
  <Bundle Name="Koppel" Manufacturer="Matumi Software" Version="$(var.Version)" UpgradeCode="5B42E92B-C631-47B4-A17F-9692A0871516"
          IconSourceFile="$(var.Logos)\koppel-app-icon.ico">
    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="hyperlinkLicense" ThemeFile="KoppelTheme.xml" LocalizationFile="KoppelTheme.wxl"
                                              LogoFile="$(var.Logos)\koppel-app-icon-64.png" LicenseUrl="https://opensource.org/license/mit" />
      <!-- The setup window's title-bar icon (IconFile in KoppelTheme.xml). -->
      <Payload SourceFile="$(var.Logos)\koppel-app-icon.ico" Name="koppel.ico" />
    </BootstrapperApplication>

    <!-- Skip the runtime when this build of it, or a newer one, is already installed. -->
    <util:RegistrySearch Root="HKLM" Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64" Value="Bld" Variable="VCRuntimeBuild" Bitness="always64" />

    <Chain>
      <ExePackage Id="VCRedist" SourceFile="$(var.VCRedist)" DisplayName="Microsoft Visual C++ Runtime"
                  DetectCondition="VCRuntimeBuild &gt;= $(var.VCRedistBuild)"
                  InstallArguments="/install /quiet /norestart" Permanent="yes" Vital="yes" PerMachine="yes">
        <!-- 1638: a newer runtime is already there. -->
        <ExitCode Value="1638" Behavior="success" />
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>
      <MsiPackage SourceFile="$(var.Msi)" />
    </Chain>
  </Bundle>
</Wix>
