<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- The MSI: Koppel as a Windows service, plus usbip-win2's driver. build.ps1 stages the files. -->
  <PropertyGroup>
    <OutputName>Koppel</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <!-- ICE61: MajorUpgrade AllowSameVersionUpgrades is deliberate, see Package.wxs. ICE43 and ICE57: the Start menu
         shortcut is per machine (the package is, so ProgramMenuFolder is the all-users Start menu), and these ICEs ask for
         the HKCU key path a per-user shortcut needs. -->
    <SuppressIces>ICE61;ICE43;ICE57</SuppressIces>
    <Logos>$(MSBuildThisFileDirectory)..\..\..\..\resources\design-system\assets\Logos</Logos>
    <DefineConstants>StagingDir=$(StagingDir);Version=$(Version);Logos=$(Logos)</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" />
    <PackageReference Include="WixToolset.Firewall.wixext" />
  </ItemGroup>

</Project>
