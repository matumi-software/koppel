<?xml version="1.0" encoding="utf-8"?>
<!-- Koppel's setup window: WiX 5's HyperlinkTheme (Microsoft Reciprocal License) with Koppel's colours
     and type from resources/design-system. Colours are Windows COLORREF values, so hex runs blue,
     green, red: bg-page #FBF9F4 is F4F9FB, text-primary #1C1B18 is 181B1C, text-secondary #5C584D
     is 4D585C and accent #2A6B4E is 4E6B2A. Instrument Sans is not on most machines, so the design
     system's fallback, Segoe UI, sets the text. Control names must stay as they are: the setup
     engine finds them by name. -->
<Theme xmlns="http://wixtoolset.org/schemas/v4/thmutil">
    <Font Id="0" Height="-12" Weight="400" Foreground="181B1C" Background="F4F9FB">Segoe UI</Font>
    <Font Id="1" Height="-26" Weight="600" Foreground="181B1C" Background="F4F9FB">Segoe UI</Font>
    <Font Id="2" Height="-18" Weight="600" Foreground="4E6B2A" Background="F4F9FB">Segoe UI</Font>
    <Font Id="3" Height="-12" Weight="400" Foreground="4D585C" Background="F4F9FB">Segoe UI</Font>

    <Window Width="485" Height="300" HexStyle="100a0000" FontId="0" Caption="#(loc.Caption)" IconFile="koppel.ico">
        <ImageControl X="16" Y="16" Width="64" Height="64" ImageFile="logo.png" Visible="yes"/>
        <Label Name="BrandName" X="92" Y="18" Width="-16" Height="34" FontId="1" DisablePrefix="yes">Koppel</Label>
        <Label Name="BrandTagline" X="92" Y="54" Width="-16" Height="20" FontId="3" DisablePrefix="yes">Share and attach USB devices over the network.</Label>

        <Page Name="Help">
            <Label X="16" Y="96" Width="-16" Height="28" FontId="2" DisablePrefix="yes">#(loc.HelpHeader)</Label>
            <Label X="16" Y="128" Width="-16" Height="-45" FontId="3" DisablePrefix="yes">#(loc.HelpText)</Label>
            <Button Name="HelpCloseButton" X="-16" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.HelpCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Loading">
            <Label X="16" Y="96" Width="-16" Height="28" FontId="2" DisablePrefix="yes" Visible="no" Name="CheckingForUpdatesLabel" />
        </Page>
        <Page Name="Install">
            <Label X="16" Y="96" Width="-16" Height="40" FontId="3" DisablePrefix="yes">Installs Koppel as a Windows service with the USB/IP driver it attaches devices through. Koppel opens at https://localhost:5240/.</Label>
            <Hypertext Name="EulaHyperlink" X="16" Y="142" Width="-16" Height="40" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallLicenseLinkText)</Hypertext>
            <Checkbox Name="EulaAcceptCheckbox" X="-16" Y="-52" Width="260" Height="17" TabStop="yes" FontId="3" HideWhenDisabled="yes">#(loc.InstallAcceptCheckbox)</Checkbox>
            <Button Name="InstallUpdateButton" X="16" Y="-16" Width="200" Height="26" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="OptionsButton" X="-184" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0" VisibleCondition="NOT WixStdBASuppressOptionsUI">
                <Text>#(loc.InstallOptionsButton)</Text>
                <ChangePageAction Page="Options" />
            </Button>
            <Button Name="InstallButton" X="-100" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">#(loc.InstallInstallButton)</Button>
            <Button Name="InstallCancelButton" X="-16" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.InstallCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Options">
            <Label X="16" Y="96" Width="-16" Height="28" FontId="2" DisablePrefix="yes">#(loc.OptionsHeader)</Label>
            <Label X="16" Y="130" Width="-16" Height="17" FontId="3" DisablePrefix="yes">#(loc.OptionsLocationLabel)</Label>
            <Editbox Name="InstallFolder" X="16" Y="152" Width="-104" Height="23" TabStop="yes" FontId="0" FileSystemAutoComplete="yes" />
            <Button Name="BrowseButton" X="-16" Y="151" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsBrowseButton)</Text>
                <BrowseDirectoryAction VariableName="InstallFolder" />
            </Button>
            <Button Name="OptionsOkButton" X="-100" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsOkButton)</Text>
                <ChangePageAction Page="Install" />
            </Button>
            <Button Name="OptionsCancelButton" X="-16" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.OptionsCancelButton)</Text>
                <ChangePageAction Page="Install" Cancel="yes" />
            </Button>
        </Page>
        <Page Name="Progress">
            <Label X="16" Y="96" Width="-16" Height="28" FontId="2" DisablePrefix="yes">#(loc.ProgressHeader)</Label>
            <Label X="16" Y="130" Width="70" Height="17" FontId="3" DisablePrefix="yes">#(loc.ProgressLabel)</Label>
            <Label Name="OverallProgressPackageText" X="90" Y="130" Width="-16" Height="17" FontId="3" DisablePrefix="yes">#(loc.OverallProgressPackageText)</Label>
            <Progressbar Name="OverallCalculatedProgressbar" X="16" Y="152" Width="-16" Height="15" />
            <Button Name="ProgressCancelButton" X="-16" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">#(loc.ProgressCancelButton)</Button>
        </Page>
        <Page Name="Modify">
            <Label X="16" Y="96" Width="-16" Height="28" FontId="2" DisablePrefix="yes">#(loc.ModifyHeader)</Label>
            <Button Name="ModifyUpdateButton" X="16" Y="-16" Width="200" Height="26" TabStop="yes" FontId="0" EnableCondition="WixStdBAUpdateAvailable" HideWhenDisabled="yes">#(loc.UpdateButton)</Button>
            <Button Name="RepairButton" X="-184" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.ModifyRepairButton)</Button>
            <Button Name="UninstallButton" X="-100" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">#(loc.ModifyUninstallButton)</Button>
            <Button Name="ModifyCancelButton" X="-16" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.ModifyCancelButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Success">
            <Label X="16" Y="96" Width="-16" Height="28" FontId="2" DisablePrefix="yes">
                <Text>#(loc.SuccessHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.SuccessLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.SuccessUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.SuccessCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.SuccessInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.SuccessModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.SuccessRepairHeader)</Text>
            </Label>
            <Label X="16" Y="130" Width="-16" Height="40" FontId="3" DisablePrefix="yes" VisibleCondition="WixBundleAction = 6">Open https://localhost:5240/ to set Koppel up.</Label>
            <Button Name="LaunchButton" X="-100" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessLaunchButton)</Button>
            <Label X="-16" Y="-56" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">
                <Text>#(loc.SuccessRestartText)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.SuccessUninstallRestartText)</Text>
            </Label>
            <Button Name="SuccessRestartButton" X="-100" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.SuccessRestartButton)</Button>
            <Button Name="SuccessCloseButton" X="-16" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.SuccessCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
        <Page Name="Failure">
            <Label X="16" Y="96" Width="-16" Height="28" FontId="2" DisablePrefix="yes">
                <Text>#(loc.FailureHeader)</Text>
                <Text Condition="WixBundleAction = 2">#(loc.FailureLayoutHeader)</Text>
                <Text Condition="WixBundleAction = 3">#(loc.FailureUnsafeUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 4">#(loc.FailureUninstallHeader)</Text>
                <Text Condition="WixBundleAction = 5">#(loc.FailureCacheHeader)</Text>
                <Text Condition="WixBundleAction = 6">#(loc.FailureInstallHeader)</Text>
                <Text Condition="WixBundleAction = 7">#(loc.FailureModifyHeader)</Text>
                <Text Condition="WixBundleAction = 8">#(loc.FailureRepairHeader)</Text>
            </Label>
            <Hypertext Name="FailureLogFileLink" X="16" Y="130" Width="-16" Height="42" FontId="3" TabStop="yes" HideWhenDisabled="yes">#(loc.FailureHyperlinkLogText)</Hypertext>
            <Hypertext Name="FailureMessageText" X="16" Y="172" Width="-16" Height="40" FontId="3" TabStop="yes" HideWhenDisabled="yes" />
            <Label X="-16" Y="-56" Width="400" Height="34" FontId="3" DisablePrefix="yes" VisibleCondition="WixStdBARestartRequired">#(loc.FailureRestartText)</Label>
            <Button Name="FailureRestartButton" X="-100" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0" HideWhenDisabled="yes">#(loc.FailureRestartButton)</Button>
            <Button Name="FailureCloseButton" X="-16" Y="-16" Width="80" Height="26" TabStop="yes" FontId="0">
                <Text>#(loc.FailureCloseButton)</Text>
                <CloseWindowAction />
            </Button>
        </Page>
    </Window>
</Theme>
